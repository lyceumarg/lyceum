# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
# Solo servidor (nunca exponer al cliente): alta de usuarios, webhooks, super-admin
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role

# Host de la app de PLATAFORMA (sitio comercial + super-admin), del lado del proveedor.
# El middleware trata este host como Sitio A y NO resuelve tenant.
PLATFORM_HOST=app.lyceum.com
